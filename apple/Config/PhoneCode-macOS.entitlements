<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: the Mac app is phone-code's hub. It reads the local
	     daemon's control file in ~/.phonecode and can start `phonecode`. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
