// Signing for your own builds. Change these two lines (or put them in
// Signing.local.xcconfig next to this file, which git ignores, so `git pull`
// never conflicts with your edits).
//
// PC_BUNDLE_ID_PREFIX: something unique to you, e.g. com.yourname
// DEVELOPMENT_TEAM:     your team id (Xcode > Settings > Accounts), or leave
//                       empty and pick the team in the target's Signing tab.
PC_BUNDLE_ID_PREFIX = com.example
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
