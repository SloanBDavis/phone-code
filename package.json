{
  "name": "phone-code-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @phone-code/web build && bun run --filter phone-code build",
    "release": "bun scripts/build-release.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "docs:protocol": "bun scripts/protocol-doc.ts",
    "typecheck": "bun run --filter '*' typecheck && tsgo -p scripts --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun scripts/protocol-doc.ts --check",
    "e2e": "bun run --filter e2e test",
    "dev": "bun run --filter phone-code dev",
    "prepare": "[ -n \"$CI\" ] || [ ! -d .git ] || lefthook install"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.4"
}
