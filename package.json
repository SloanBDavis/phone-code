{
  "name": "phone-code-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "bun run --filter @phone-code/web build && bun run --filter phone-code build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "e2e": "bun run --filter e2e test",
    "dev": "bun run --filter phone-code dev"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "latest",
    "oxfmt": "^0.79.0"
  }
}
